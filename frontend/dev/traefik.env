# Secret-file variables core-v2 asked for (Cloudflare token, alternative 0, + its defaults).
# Paths are inside the container; core-v2 writes the files to <demo>/traefik/secrets.
CLOUDFLARE_DNS_API_TOKEN_FILE=/etc/traefik/secrets/cloudflare_dns_api_token.secret
CLOUDFLARE_POLLING_INTERVAL_FILE=/etc/traefik/secrets/cloudflare_polling_interval.secret
CLOUDFLARE_PROPAGATION_TIMEOUT_FILE=/etc/traefik/secrets/cloudflare_propagation_timeout.secret
CLOUDFLARE_TTL_FILE=/etc/traefik/secrets/cloudflare_ttl.secret
