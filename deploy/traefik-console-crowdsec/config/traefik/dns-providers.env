# DNS provider credentials for Traefik's certificate resolvers. Do not edit:
# generated by tools/dns-env/generate.py from the provider list Traefik Console supports.
#
# Each line points a provider variable at a file in Traefik's secrets folder. Traefik Console
# writes those files when you create or update a resolver, so Traefik never needs new
# variables. Lines of providers you don't use are ignored.

# Azure DNS
AZURE_CLIENT_ID_FILE=/etc/traefik/secrets/azure_client_id.secret
AZURE_CLIENT_SECRET_FILE=/etc/traefik/secrets/azure_client_secret.secret
AZURE_POLLING_INTERVAL_FILE=/etc/traefik/secrets/azure_polling_interval.secret
AZURE_PROPAGATION_TIMEOUT_FILE=/etc/traefik/secrets/azure_propagation_timeout.secret
AZURE_RESOURCE_GROUP_FILE=/etc/traefik/secrets/azure_resource_group.secret
AZURE_SUBSCRIPTION_ID_FILE=/etc/traefik/secrets/azure_subscription_id.secret
AZURE_TENANT_ID_FILE=/etc/traefik/secrets/azure_tenant_id.secret
AZURE_TTL_FILE=/etc/traefik/secrets/azure_ttl.secret

# Cloudflare
CLOUDFLARE_API_KEY_FILE=/etc/traefik/secrets/cloudflare_api_key.secret
CLOUDFLARE_DNS_API_TOKEN_FILE=/etc/traefik/secrets/cloudflare_dns_api_token.secret
CLOUDFLARE_EMAIL_FILE=/etc/traefik/secrets/cloudflare_email.secret
CLOUDFLARE_POLLING_INTERVAL_FILE=/etc/traefik/secrets/cloudflare_polling_interval.secret
CLOUDFLARE_PROPAGATION_TIMEOUT_FILE=/etc/traefik/secrets/cloudflare_propagation_timeout.secret
CLOUDFLARE_TTL_FILE=/etc/traefik/secrets/cloudflare_ttl.secret
CLOUDFLARE_ZONE_API_TOKEN_FILE=/etc/traefik/secrets/cloudflare_zone_api_token.secret

# DigitalOcean
DO_API_URL_FILE=/etc/traefik/secrets/do_api_url.secret
DO_AUTH_TOKEN_FILE=/etc/traefik/secrets/do_auth_token.secret
DO_HTTP_TIMEOUT_FILE=/etc/traefik/secrets/do_http_timeout.secret
DO_POLLING_INTERVAL_FILE=/etc/traefik/secrets/do_polling_interval.secret
DO_PROPAGATION_TIMEOUT_FILE=/etc/traefik/secrets/do_propagation_timeout.secret
DO_TTL_FILE=/etc/traefik/secrets/do_ttl.secret

# DuckDNS
DUCKDNS_POLLING_INTERVAL_FILE=/etc/traefik/secrets/duckdns_polling_interval.secret
DUCKDNS_PROPAGATION_TIMEOUT_FILE=/etc/traefik/secrets/duckdns_propagation_timeout.secret
DUCKDNS_TOKEN_FILE=/etc/traefik/secrets/duckdns_token.secret

# Google Cloud DNS
GCE_ACCESS_TOKEN_FILE=/etc/traefik/secrets/gce_access_token.secret
GCE_ALLOW_PRIVATE_ZONE_FILE=/etc/traefik/secrets/gce_allow_private_zone.secret
GCE_DEBUG_FILE=/etc/traefik/secrets/gce_debug.secret
GCE_POLLING_INTERVAL_FILE=/etc/traefik/secrets/gce_polling_interval.secret
GCE_PROJECT_FILE=/etc/traefik/secrets/gce_project.secret
GCE_PROPAGATION_TIMEOUT_FILE=/etc/traefik/secrets/gce_propagation_timeout.secret
GCE_SERVICE_ACCOUNT_FILE=/etc/traefik/secrets/gce_service_account.secret
GCE_TTL_FILE=/etc/traefik/secrets/gce_ttl.secret
GCE_ZONE_ID_FILE=/etc/traefik/secrets/gce_zone_id.secret

# Hetzner
HETZNER_API_KEY_FILE=/etc/traefik/secrets/hetzner_api_key.secret
HETZNER_POLLING_INTERVAL_FILE=/etc/traefik/secrets/hetzner_polling_interval.secret
HETZNER_PROPAGATION_TIMEOUT_FILE=/etc/traefik/secrets/hetzner_propagation_timeout.secret
HETZNER_TTL_FILE=/etc/traefik/secrets/hetzner_ttl.secret

# Namecheap
NAMECHEAP_API_KEY_FILE=/etc/traefik/secrets/namecheap_api_key.secret
NAMECHEAP_API_USER_FILE=/etc/traefik/secrets/namecheap_api_user.secret
NAMECHEAP_POLLING_INTERVAL_FILE=/etc/traefik/secrets/namecheap_polling_interval.secret
NAMECHEAP_PROPAGATION_TIMEOUT_FILE=/etc/traefik/secrets/namecheap_propagation_timeout.secret
NAMECHEAP_SANDBOX_FILE=/etc/traefik/secrets/namecheap_sandbox.secret
NAMECHEAP_TTL_FILE=/etc/traefik/secrets/namecheap_ttl.secret

# OVHcloud
OVH_ACCESS_TOKEN_FILE=/etc/traefik/secrets/ovh_access_token.secret
OVH_APPLICATION_KEY_FILE=/etc/traefik/secrets/ovh_application_key.secret
OVH_APPLICATION_SECRET_FILE=/etc/traefik/secrets/ovh_application_secret.secret
OVH_CLIENT_ID_FILE=/etc/traefik/secrets/ovh_client_id.secret
OVH_CLIENT_SECRET_FILE=/etc/traefik/secrets/ovh_client_secret.secret
OVH_CONSUMER_KEY_FILE=/etc/traefik/secrets/ovh_consumer_key.secret
OVH_ENDPOINT_FILE=/etc/traefik/secrets/ovh_endpoint.secret
OVH_PROPAGATION_TIMEOUT_FILE=/etc/traefik/secrets/ovh_propagation_timeout.secret
